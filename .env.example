# The Cheddarloin — Environment Variables Configuration
# Configure these in your Netlify Site Settings: Site configuration -> Environment variables

# 1. Telegram Bot Token from @BotFather on Telegram (e.g. 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# 2. Your personal Telegram Chat ID from @userinfobot or @raw_data_bot (e.g. 987654321)
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# 3. Optional: Custom Formspree Form ID (e.g. https://formspree.io/f/xovjqqwq)
FORMSPREE_ORDER_ENDPOINT="https://formspree.io/f/YOUR_FORM_ID"
